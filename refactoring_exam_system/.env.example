# Copy to .env.local for local development (gitignored):
#   cp .env.example .env.local
#
# Vite loads (dev):  .env → .env.local  (.env.local WINS — check this file first!)
# Vite loads (build): .env → .env.production
#
# After any .env change: stop Vite → npm run dev

# Backend API base URL (no trailing slash)
# PythonAnywhere:  https://maramhasri.pythonanywhere.com
# Local Flask:     http://127.0.0.1:5000
VITE_API_BASE_URL=

# Frontend base URL — must match FRONTEND_BASE_URL on the backend (invite links)
# Local:       http://localhost:5173
# Production:  https://your-frontend.example.com
VITE_FRONTEND_BASE_URL=
